# Sensitive config
.env
.env.*
!.env.example
*.key
*.pem
native-host/manifest/eastmoney-ai-sync-installed.json
.claude/settings.local.json

# Evaluation data + budget + drafts (contains private info, never commit)
.eastmoney-ai/
data/frozen-eval-*.json

# Model weights (large files + potential license issues)
kronos/*.pt
kronos/*.safetensors
lib/lstm/*.pt
*.onnx

# Dependencies
node_modules/
package-lock.json.bak

# Tests / temp files
.eval-cache/
*.test.local.js
tmp_*.js
_test_*.js
v*-eval.js
v*-verify-eval.js
v*-verify.js
v*-full.js

# Logs
logs/
*.log

# System files
.DS_Store
Thumbs.db

# Chrome extension forbids _ prefix filenames
_*
=

# Kronos venv (rebuildable)
kronos/venv/

# IDE config
.vscode/
.idea/
*.swp
kronos/weights/
temp_scripts/
skills-lock.json

# === Security + large-data hardening (2026-06-15, pre-push) ===
# Secrets / API tokens - never commit
config/
*tushare_token*
*.token
# Large research databases (2GB+, rebuildable from raw)
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Model weights
models/
# Process IDs + scratch error logs
*.pid
data/*.err

# 散户信号生成器的运行时输出(每次跑都变,不入库)
data/retail_signal_latest.json
docs/retail-signal-latest.md
